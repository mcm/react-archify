{
  "name": "react-archify",
  "version": "0.1.0",
  "description": "React 19 component that renders Archify diagrams with the full Archify viewer.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/react-archify.js",
  "module": "./dist/react-archify.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/react-archify.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "sync:archify": "node scripts/sync-archify.mjs",
    "dev": "vite --config demo/vite.config.ts",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "build:demo": "vite build --config demo/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/unit/*.test.mjs",
    "test:e2e": "playwright test"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.6",
    "postcss-selector-parser": "^7.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.0",
    "vite-plugin-dts": "^4.5.4"
  },
  "dependencies": {
    "@noble/hashes": "^2.0.1",
    "buffer": "^6.0.3",
    "path-browserify": "^1.0.1"
  }
}
